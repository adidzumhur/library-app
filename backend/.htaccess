RewriteEngine On

# Never serve secrets, logs or dependencies directly
RewriteRule ^(config|logs|vendor)(/|$) - [F,L]

# Send every request that is not a real file or folder to index.php (FlightPHP router)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
